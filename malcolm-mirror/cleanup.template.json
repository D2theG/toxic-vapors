{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Scoped scheduled teardown for the approved mirror experiment and an actual non-compute cleanup test; no access to the original demo stack.",
  "Metadata": {
    "com.aws.cloudformation.Context": {
      "must": [
        "Resource allowlists must contain only experimental stack resources.",
        "Keep controller until deletion is verified; then remove controller too.",
        "A successful DeleteStack API call is not proof that resource deletion completed."
      ]
    }
  },
  "Parameters": {
    "TargetStackArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws[a-z-]*:cloudformation:[a-z0-9-]+:[0-9]{12}:stack/fed-cortex-demo-mirror-lab/.*"
    },
    "TestStackArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws[a-z-]*:cloudformation:[a-z0-9-]+:[0-9]{12}:stack/fed-cortex-demo-mirror-cleanup-test/.*"
    },
    "OwnedEc2Arns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact EC2 resource ARNs from only the two experimental stacks."
    },
    "OwnedIamArns": {
      "Type": "CommaDelimitedList",
      "Description": "Exact role/profile ARNs from only the two experimental stacks."
    },
    "TestAtUtc": {
      "Type": "String",
      "AllowedPattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
    },
    "TeardownAtCentral": {
      "Type": "String",
      "Default": "2026-11-06T17:05:00",
      "AllowedPattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
    }
  },
  "Resources": {
    "ScheduleGroup": {
      "Type": "AWS::Scheduler::ScheduleGroup"
    },
    "FailureQueue": {
      "Type": "AWS::SQS::Queue",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 86400
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  },
                  "aws:SourceArn": {
                    "Fn::GetAtt": [
                      "ScheduleGroup",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeleteOnlyOwnedLabResources",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "DeleteOnlyExperimentalStacks",
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DeleteStack",
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackResources",
                    "cloudformation:DescribeStackEvents",
                    "cloudformation:ListStackResources"
                  ],
                  "Resource": [
                    {
                      "Ref": "TargetStackArn"
                    },
                    {
                      "Ref": "TestStackArn"
                    }
                  ]
                },
                {
                  "Sid": "DeleteOnlyOwnedEc2",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:TerminateInstances",
                    "ec2:DeleteNetworkInterface",
                    "ec2:DeleteSecurityGroup",
                    "ec2:DeleteTrafficMirrorSession",
                    "ec2:DeleteTrafficMirrorTarget",
                    "ec2:DeleteTrafficMirrorFilter",
                    "ec2:DeleteTrafficMirrorFilterRule"
                  ],
                  "Resource": {
                    "Ref": "OwnedEc2Arns"
                  }
                },
                {
                  "Sid": "ReadEc2DeletionState",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeTrafficMirrorSessions",
                    "ec2:DescribeTrafficMirrorTargets",
                    "ec2:DescribeTrafficMirrorFilters"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "DeleteOnlyOwnedIam",
                  "Effect": "Allow",
                  "Action": [
                    "iam:DeleteRole",
                    "iam:DetachRolePolicy",
                    "iam:DeleteRolePolicy",
                    "iam:GetRole",
                    "iam:ListRolePolicies",
                    "iam:ListAttachedRolePolicies",
                    "iam:DeleteInstanceProfile",
                    "iam:RemoveRoleFromInstanceProfile",
                    "iam:GetInstanceProfile",
                    "iam:ListInstanceProfilesForRole"
                  ],
                  "Resource": {
                    "Ref": "OwnedIamArns"
                  }
                },
                {
                  "Sid": "RecordDeliveryFailures",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "FailureQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "FridayTeardown": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "GroupName": {
          "Ref": "ScheduleGroup"
        },
        "ScheduleExpression": {
          "Fn::Sub": "at(${TeardownAtCentral})"
        },
        "ScheduleExpressionTimezone": "America/Chicago",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:scheduler:::aws-sdk:cloudformation:deleteStack"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "ExecutionRole",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"StackName\":\"${TargetStackArn}\"}"
          },
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 3600,
            "MaximumRetryAttempts": 5
          },
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "FailureQueue",
                "Arn"
              ]
            }
          }
        }
      }
    },
    "CleanupTest": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "GroupName": {
          "Ref": "ScheduleGroup"
        },
        "ScheduleExpression": {
          "Fn::Sub": "at(${TestAtUtc})"
        },
        "ScheduleExpressionTimezone": "UTC",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:scheduler:::aws-sdk:cloudformation:deleteStack"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "ExecutionRole",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"StackName\":\"${TestStackArn}\"}"
          },
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 3600,
            "MaximumRetryAttempts": 5
          },
          "DeadLetterConfig": {
            "Arn": {
              "Fn::GetAtt": [
                "FailureQueue",
                "Arn"
              ]
            }
          }
        }
      }
    }
  },
  "Outputs": {
    "ExecutionRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ExecutionRole",
          "Arn"
        ]
      }
    },
    "ScheduleGroupName": {
      "Value": {
        "Ref": "ScheduleGroup"
      }
    },
    "FridayScheduleName": {
      "Value": {
        "Ref": "FridayTeardown"
      }
    },
    "TestScheduleName": {
      "Value": {
        "Ref": "CleanupTest"
      }
    },
    "FailureQueueUrl": {
      "Value": {
        "Ref": "FailureQueue"
      }
    }
  }
}
