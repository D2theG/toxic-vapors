{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Temporary unattached resources to verify scheduled cleanup without touching the running lab.",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "Default": "fed-cortex-demo",
      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9-]{0,31}"
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "Description": "Existing source VPC. No routes or existing security groups are modified."
    },
    "SensorSubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Existing subnet in source VPC and source AZ, with working egress and SSM."
    },
    "SourceIpv4Cidr": {
      "Type": "String",
      "AllowedPattern": "([0-9]{1,3}\\.){3}[0-9]{1,3}/32",
      "Description": "Primary private IPv4 of the source ENI with /32; verified by preflight."
    },
    "ResolverIpv4Cidr": {
      "Type": "String",
      "AllowedPattern": "([0-9]{1,3}\\.){3}[0-9]{1,3}/32",
      "Description": "VPC DNS resolver address with /32."
    }
  },
  "Resources": {
    "SensorRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "SSM-only administration; no application access to the lab account",
          "must": [
            "Do not add administrator or source-host mutation permissions."
          ]
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ]
      }
    },
    "SensorProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "SensorRole"
          }
        ]
      }
    },
    "SensorSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private passive target; admin through SSM, not inbound SSH or HTTPS",
          "must": [
            "Only source ENI primary IPv4 may send UDP 4789.",
            "Do not attach this group to existing resources."
          ]
        }
      },
      "Properties": {
        "GroupDescription": "Private mirror sensor with source-scoped VXLAN ingress",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "udp",
            "FromPort": 4789,
            "ToPort": 4789,
            "CidrIp": {
              "Ref": "SourceIpv4Cidr"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0",
            "Description": "Package repositories, container pulls and SSM"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "Package repositories, container pulls and SSM"
          },
          {
            "IpProtocol": "udp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": {
              "Ref": "ResolverIpv4Cidr"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 53,
            "ToPort": 53,
            "CidrIp": {
              "Ref": "ResolverIpv4Cidr"
            }
          }
        ]
      }
    },
    "SensorEni": {
      "Type": "AWS::EC2::NetworkInterface",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Explicit target ENI avoids unsupported primary-ENI instance attributes",
          "must": [
            "Keep subnet in the source VPC and AZ; preserve source/destination checks."
          ]
        }
      },
      "Properties": {
        "SubnetId": {
          "Ref": "SensorSubnetId"
        },
        "GroupSet": [
          {
            "Ref": "SensorSecurityGroup"
          }
        ],
        "SourceDestCheck": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${EnvironmentName}-${AWS::StackName}-sensor-eni"
            }
          }
        ]
      }
    },
    "MirrorFilter": {
      "Type": "AWS::EC2::TrafficMirrorFilter",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Capture both directions on one lab ENI including Amazon DNS",
          "must": [
            "NetworkServices amazon-dns is required for Amazon-provided DNS mirroring."
          ]
        }
      },
      "Properties": {
        "Description": "One-source IPv4 lab traffic plus Amazon DNS",
        "NetworkServices": [
          "amazon-dns"
        ]
      }
    },
    "MirrorIngress": {
      "Type": "AWS::EC2::TrafficMirrorFilterRule",
      "Properties": {
        "TrafficMirrorFilterId": {
          "Ref": "MirrorFilter"
        },
        "TrafficDirection": "ingress",
        "RuleNumber": 100,
        "RuleAction": "accept",
        "SourceCidrBlock": "0.0.0.0/0",
        "DestinationCidrBlock": "0.0.0.0/0"
      }
    },
    "MirrorEgress": {
      "Type": "AWS::EC2::TrafficMirrorFilterRule",
      "Properties": {
        "TrafficMirrorFilterId": {
          "Ref": "MirrorFilter"
        },
        "TrafficDirection": "egress",
        "RuleNumber": 100,
        "RuleAction": "accept",
        "SourceCidrBlock": "0.0.0.0/0",
        "DestinationCidrBlock": "0.0.0.0/0"
      }
    }
  }
}
